# Railway Postgres plugin ავტომატურად აყენებს DATABASE_URL-ს.
# ლოკალურად ტესტისთვის:
DATABASE_URL=postgresql://user:password@localhost:5432/bebos
# CORS — მიუთითე Vercel დომენი, ან * ყველასთვის
CORS_ORIGIN=*
PORT=3000
# JWT — რეგისტრაცია/შესვლის ტოკენების ხელმოწერისთვის (ჩაწერე გრძელი შემთხვევითი სტრიქონი)
JWT_SECRET=change-me-to-a-long-random-string
# ADMIN — მძიმით გამოყოფილი ელფოსტები, ვისაც ადმინის პანელი (admin.html) ეხსნება
ADMIN_EMAILS=you@example.com
